### [RS1] KỲ VỌNG: 201, tạo dòng resource_type='DATASET'
# Kiểm DB: category_resources có dòng, resource_type='DATASET'
# Bảng mới hoạt động
POST {{baseUrl}}/api/events/{{testEventId}}/categories/{{catWebId}}/resources
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "label": "Dataset mẫu Web",
  "url": "https://drive.example.com/web-dataset.zip",
  "resourceType": "DATASET"
}

> {%
  client.global.set("resourceId", response.body.data.id);
%}


### [RS2] KỲ VỌNG: 200, xem được (isAuthenticated — bất kỳ vai có token)
# Thí sinh xem tài liệu
GET {{baseUrl}}/api/events/{{testEventId}}/categories/{{catWebId}}/resources
Authorization: Bearer {{leaderToken}}


### [RS3] KỲ VỌNG: Bị chặn (403 — chỉ COORDINATOR ghi)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Phân quyền đọc/ghi — participant không được POST
POST {{baseUrl}}/api/events/{{testEventId}}/categories/{{catWebId}}/resources
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "label": "Không được phép",
  "url": "https://attacker.example.com/malicious.zip",
  "resourceType": "LINK"
}


### [RS4] KỲ VỌNG: Bị chặn (400 — enum không hợp lệ)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Enum hợp lệ: DATASET/DOC/SAMPLE/LINK/OTHER
POST {{baseUrl}}/api/events/{{testEventId}}/categories/{{catWebId}}/resources
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "label": "Tài liệu sai enum",
  "url": "https://drive.example.com/doc.pdf",
  "resourceType": "XXX"
}


### [RS5] KỲ VỌNG: 200/204, dòng biến mất
