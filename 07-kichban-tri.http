# ============================================================
# 07 — KỊCH BẢN KIỂM CHỨNG PHẦN CỦA TRÍ
# Event/Round config + Account/Team approval + Capacity + Mentor planning
# Nguồn: SEAL_kich_ban_test_phan_TRI.md
# ============================================================
# SEED ACCOUNTS (password = Password1):
#   id=3   coord@seal.local           role=COORDINATOR
#   id=?   super@seal.local           role=SUPER_COORDINATOR
#   id=4   judge.internal@seal.local  role=JUDGE
#   id=7   leader@student.local       role=TEAM_LEADER
# SEED THAM CHIẾU (xem 03-event-flow.http):
#   disciplines : id=1 (SE), id=2 (AI), ...
#   term_plans  : id=1 (SUMMER 2026 / SE), id=2 (SUMMER 2026 / AI), ...
#   ⚠ Nếu seed DB khác, cần lấy disciplineId + termPlanId bằng GET trước
# ============================================================
# THỨ TỰ CHẠY: từ trên xuống trong cùng một run session.
# Các id chụp qua client.global.set() và truyền cho request sau.
# ============================================================

### ─── BƯỚC 0: LẤY TOKEN 4 VAI ────────────────────────────────

### [00-coord] Login coord@seal.local
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "coord@seal.local",
  "password": "Password1"
}

> {%
  client.global.set("coordToken", response.body.data.accessToken);
%}


### [00-super] Login super@seal.local
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "super@seal.local",
  "password": "Password1"
}

> {%
  client.global.set("superToken", response.body.data.accessToken);
%}


### [00-judge] Login judge.internal@seal.local
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "judge.internal@seal.local",
  "password": "Password1"
}

> {%
  client.global.set("judgeToken", response.body.data.accessToken);
%}


### [00-leader] Login leader@student.local
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "leader@student.local",
  "password": "Password1"
}

> {%
  client.global.set("leaderToken", response.body.data.accessToken);
%}


###
# ============================================================
# NHÓM 1 — Duyệt tài khoản (FR-AUTH-08, BR-GOV-02)
# ============================================================

### [A1] KỲ VỌNG: 201, tài khoản tạo ở trạng thái PENDING
# Kiểm DB: users.status='PENDING'
# Vì sao: Người mới không được vào ngay
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "tri-test-a1@student.local",
  "password": "Password1",
  "fullName": "Nguyen Van A1",
  "phone": "0900000001",
  "fptStudent": true,
  "studentId": "FPT-A1-001",
  "university": "FPT University"
}

> {%
  client.global.set("newUserId", response.body.data.userId);
%}


### [A2] KỲ VỌNG: Bị chặn (401/403 — chưa duyệt)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Kiểm: PENDING không đăng nhập được
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "tri-test-a1@student.local",
  "password": "Password1"
}


### [A3] KỲ VỌNG: 200, có account A1 trong danh sách
# Coordinator thấy hàng chờ
GET {{baseUrl}}/api/auth/accounts/pending
Authorization: Bearer {{coordToken}}


### [A4] KỲ VỌNG: 200, status → ACTIVE
# Kiểm DB: users.status='ACTIVE'
# Vòng đời tài khoản: duyệt hợp lệ
POST {{baseUrl}}/api/auth/accounts/{{newUserId}}/approve
Authorization: Bearer {{coordToken}}


### [A5] KỲ VỌNG: 200, đăng nhập được sau khi duyệt
# Vòng đời tài khoản đúng
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "tri-test-a1@student.local",
  "password": "Password1"
}

> {%
  client.global.set("a1Token", response.body.data.accessToken);
%}


### [A6] KỲ VỌNG: Bị chặn (400 — reason bắt buộc)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Từ chối phải có lý do
# LƯU Ý: cần 1 account PENDING khác để reject — dùng id giả 999999 sẽ ra 404;
#   nếu muốn test đúng 400, cần tạo thêm account PENDING rồi reject không có reason.
#   Đây là case test validation body {} → 400.
POST {{baseUrl}}/api/auth/accounts/{{newUserId}}/reject
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{}


### [A7] KỲ VỌNG: Bị chặn (business rule — không tự duyệt mình)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Coordinator approve chính userId của mình (id=3 theo seed)
# LƯU Ý: kịch bản ghi "userId = coord" nhưng code dùng @PathVariable — cần điền tay id của coord
#   Nếu seed coord là id=3: đổi path thành /api/auth/accounts/3/approve
POST {{baseUrl}}/api/auth/accounts/3/approve
Authorization: Bearer {{coordToken}}


### [A8] KỲ VỌNG: 200, status → REJECTED
# Kiểm DB: users.status='REJECTED'
# Nhánh từ chối — cần tạo thêm 1 account PENDING
# Bước phụ: tạo account pending mới
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "tri-test-a8@student.local",
  "password": "Password1",
  "fullName": "Nguyen Van A8",
  "fptStudent": false
}

> {%
  client.global.set("rejectUserId", response.body.data.userId);
%}


### [A8-reject] Từ chối account A8 — KỲ VỌNG: 200, status → REJECTED
POST {{baseUrl}}/api/auth/accounts/{{rejectUserId}}/reject
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "reason": "Không đủ điều kiện tham gia theo quy định sự kiện"
}


###
# ============================================================
# NHÓM 2 — Vòng đời Event (FR-EVT-01, quy trình duyệt 2 cấp)
# ============================================================

### [E1] KỲ VỌNG: 201, event trạng thái DRAFT
# Kiểm DB: events.status='DRAFT'
# Tạo nháp event
# ⚠ CẦN ĐIỀN TAY: disciplineId=1 + termPlanId=1 (SE / SUMMER 2026) — xác nhận bằng seed
POST {{baseUrl}}/api/events
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "SEAL Kịch bản Trí — Event E1",
  "disciplineId": 1,
  "termPlanId": 1,
  "eventType": "SUMMER",
  "description": "Event kiểm chứng kịch bản Trí",
  "registrationStart": "2026-08-01T08:00:00",
  "registrationEnd": "2026-08-31T23:59:59"
}

> {%
  client.global.set("testEventId", response.body.data.id);
%}


### [E2] KỲ VỌNG: 200, lưu 4 cột capacity
# Kiểm DB: events.max_teams=3, max_team_size=4, max_participants=12, max_teams_per_mentor=2
# Override capacity theo event (tầng 2)
PATCH {{baseUrl}}/api/events/{{testEventId}}
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "maxTeamSize": 4,
  "maxTeams": 3,
  "maxParticipants": 12,
  "maxTeamsPerMentor": 2
}


### [E3] KỲ VỌNG: Bị chặn (event chưa mở)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Kiểm: không tạo team — event đang DRAFT
# ⚠ CẦN ĐIỀN TAY: categoryId — dùng 1 categoryId hợp lệ (hoặc thử bất kỳ)
POST {{baseUrl}}/api/teams
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "name": "E3-ShouldFail",
  "description": "Thử đăng ký khi event chưa OPEN",
  "eventId": {{testEventId}},
  "categoryId": 1
}


### E4-SETUP: Thêm round (cần để submit event)
# KỲ VỌNG: 201 — round tạo thành công
POST {{baseUrl}}/api/events/{{testEventId}}/rounds
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Sơ loại",
  "orderNumber": 1,
  "submissionDeadline": "2026-09-10T23:59:59",
  "scoringDeadline": "2026-09-15T23:59:59",
  "promotionTopN": 2,
  "finalRound": false,
  "requiresRepo": true,
  "requiresDemo": false,
  "requiresSlide": false,
  "requiresReport": false
}

> {%
  client.global.set("round1Id", response.body.data.id);
%}


### E4-SETUP-2: Thêm criteria set (cần để submit) — weight phải tổng = 100
# KỲ VỌNG: 201
POST {{baseUrl}}/api/events/{{testEventId}}/criteria-sets
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Bộ tiêu chí vòng sơ loại",
  "description": "Dùng cho submit setup",
  "roundId": {{round1Id}},
  "categoryId": null,
  "promotionTopN": null,
  "criteria": [
    { "name": "Ý tưởng", "maxScore": 10, "weight": 60, "displayOrder": 1 },
    { "name": "Demo", "maxScore": 10, "weight": 40, "displayOrder": 2 }
  ]
}


### [E4] KỲ VỌNG: 200, trạng thái → PENDING_APPROVAL
# Kiểm DB: events.status đổi thành PENDING_APPROVAL
POST {{baseUrl}}/api/events/{{testEventId}}/submit
Authorization: Bearer {{coordToken}}


### [E5] KỲ VỌNG: Bị chặn (403 — chỉ SUPER_COORDINATOR mới approve được)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Phân quyền duyệt 2 cấp — Coordinator tự approve bị chặn
POST {{baseUrl}}/api/events/{{testEventId}}/approve
Authorization: Bearer {{coordToken}}


### [E6] KỲ VỌNG: 200 → APPROVED
# Kiểm DB: events.status='APPROVED'
# Cấp trên duyệt
POST {{baseUrl}}/api/events/{{testEventId}}/approve
Authorization: Bearer {{superToken}}


### [E7] KỲ VỌNG: 200 → OPEN (mở đăng ký)
# Kiểm DB: events.status='OPEN'
# Mở cổng team
POST {{baseUrl}}/api/events/{{testEventId}}/open
Authorization: Bearer {{coordToken}}


### [E8-SETUP] Tạo event thứ 2 để test nhánh reject
POST {{baseUrl}}/api/events
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "SEAL Kịch bản Trí — Event E8 (nhánh reject)",
  "disciplineId": 1,
  "termPlanId": 1,
  "eventType": "SUMMER",
  "description": "Event để kiểm nhánh từ chối",
  "registrationStart": "2026-09-01T08:00:00",
  "registrationEnd": "2026-09-30T23:59:59"
}

> {%
  client.global.set("rejectEventId", response.body.data.id);
%}


### E8-SETUP-2: Thêm round + criteria cho event 2
POST {{baseUrl}}/api/events/{{rejectEventId}}/rounds
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Vòng duy nhất",
  "orderNumber": 1,
  "finalRound": true,
  "requiresRepo": true,
  "requiresDemo": false,
  "requiresSlide": false,
  "requiresReport": false
}

> {%
  client.global.set("rejectRoundId", response.body.data.id);
%}


### E8-SETUP-3: Criteria cho event 2
POST {{baseUrl}}/api/events/{{rejectEventId}}/criteria-sets
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Bộ tiêu chí",
  "roundId": {{rejectRoundId}},
  "categoryId": null,
  "promotionTopN": null,
  "criteria": [
    { "name": "Tiêu chí A", "maxScore": 10, "weight": 100, "displayOrder": 1 }
  ]
}


### E8-SETUP-4: Submit event 2
POST {{baseUrl}}/api/events/{{rejectEventId}}/submit
Authorization: Bearer {{coordToken}}


### [E8] KỲ VỌNG: 200 → REJECTED, không mở được
# Kiểm DB: events.status='REJECTED'
# Nhánh từ chối event bởi Super Coordinator
POST {{baseUrl}}/api/events/{{rejectEventId}}/reject
Authorization: Bearer {{superToken}}
Content-Type: application/json

{
  "reason": "Event không đáp ứng yêu cầu chất lượng tối thiểu"
}


###
# ============================================================
# NHÓM 3 — Cấu hình Round (FR-EVT-02)
# Dùng testEventId đã OPEN từ E7
# ============================================================

### [R1] KỲ VỌNG: 201, round tạo với đủ 10 field
# Kiểm DB: rounds.scoring_deadline có giá trị; requires_repo=1
# Vòng này bắt buộc nộp repo
# LƯU Ý: testEventId đã có 1 round từ setup E4 (orderNumber=1)
#   → dùng orderNumber=3 để tránh trùng
POST {{baseUrl}}/api/events/{{testEventId}}/rounds
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Sơ loại R1",
  "orderNumber": 3,
  "submissionDeadline": "2026-09-10T23:59:59",
  "scoringDeadline": "2026-09-15T23:59:59",
  "promotionTopN": 2,
  "finalRound": false,
  "requiresRepo": true,
  "requiresDemo": false,
  "requiresSlide": false,
  "requiresReport": false
}

> {%
  client.global.set("r1Id", response.body.data.id);
%}


### [R2] KỲ VỌNG: 201, finalRound=true, requires khác vòng 1
# Kiểm DB: rounds.is_final_round=1, requires_demo=1
# "Mỗi vòng nộp gì" khác nhau — logic tinh tế
POST {{baseUrl}}/api/events/{{testEventId}}/rounds
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Chung kết",
  "orderNumber": 4,
  "submissionDeadline": "2026-10-01T23:59:59",
  "scoringDeadline": "2026-10-05T23:59:59",
  "promotionTopN": null,
  "finalRound": true,
  "requiresRepo": false,
  "requiresDemo": true,
  "requiresSlide": true,
  "requiresReport": false
}

> {%
  client.global.set("r2Id", response.body.data.id);
%}


### [R3] KỲ VỌNG: 200, scoringDeadline + 4 cờ requires* trả đúng, không null lệch
# Response khớp cấu hình (đồng nhất FE/BE)
GET {{baseUrl}}/api/events/{{testEventId}}/rounds
Authorization: Bearer {{coordToken}}


### [R4] KỲ VỌNG: Bị chặn (400 validation)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Ràng buộc dữ liệu — thiếu orderNumber (bắt buộc @NotNull @Min(1))
POST {{baseUrl}}/api/events/{{testEventId}}/rounds
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Vòng thiếu orderNumber",
  "finalRound": false,
  "requiresRepo": true,
  "requiresDemo": false,
  "requiresSlide": false,
  "requiresReport": false
}


###
# ============================================================
# NHÓM 4 — Category + Criteria-set theo từng category
# (điểm cốt lõi: Model A + per-category)
# ============================================================

### [C1-a] KỲ VỌNG: 201, tạo category "Web"
# Kiểm DB: categories 2 dòng sau khi tạo đủ
# 1 event nhiều hạng mục
POST {{baseUrl}}/api/events/{{testEventId}}/categories
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Web"
}

> {%
  client.global.set("catWebId", response.body.data.id);
%}


### [C1-b] KỲ VỌNG: 201, tạo category "AI" (với mentorId nếu có)
# ⚠ CẦN ĐIỀN TAY: mentorId — lấy từ GET /api/mentors
#   Nếu không có mentor seed, xóa trường mentorId hoặc đặt null
POST {{baseUrl}}/api/events/{{testEventId}}/categories
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "AI",
  "mentorId": null
}

> {%
  client.global.set("catAIId", response.body.data.id);
%}


### [C2] KỲ VỌNG: 201, set gắn categoryId=Web, topN=2
# Kiểm DB: criteria_sets.category_id=<Web>, promotion_top_n=2
# Trọng số/topN riêng theo hạng mục
POST {{baseUrl}}/api/events/{{testEventId}}/criteria-sets
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Bộ Web — Vòng sơ loại",
  "description": "Tiêu chí riêng cho hạng mục Web",
  "roundId": {{round1Id}},
  "categoryId": {{catWebId}},
  "promotionTopN": 2,
  "criteria": [
    { "name": "Giao diện", "maxScore": 10, "weight": 40, "displayOrder": 1 },
    { "name": "Tính năng", "maxScore": 10, "weight": 40, "displayOrder": 2 },
    { "name": "Hiệu năng", "maxScore": 10, "weight": 20, "displayOrder": 3 }
  ]
}

> {%
  client.global.set("csWebId", response.body.data.id);
%}


### [C3] KỲ VỌNG: 201, nhiều criteria-set/round (mỗi category 1 bộ)
# Kiểm DB: 2 dòng criteria_sets cùng round_id, khác category_id
# Chứng minh Model A đáp ứng "khác trọng số, khác topN"
POST {{baseUrl}}/api/events/{{testEventId}}/criteria-sets
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "name": "Bộ AI — Vòng sơ loại",
  "description": "Tiêu chí riêng cho hạng mục AI — trọng số khác Web",
  "roundId": {{round1Id}},
  "categoryId": {{catAIId}},
  "promotionTopN": 1,
  "criteria": [
    { "name": "Độ chính xác mô hình", "maxScore": 10, "weight": 60, "displayOrder": 1 },
    { "name": "Sáng tạo thuật toán", "maxScore": 10, "weight": 40, "displayOrder": 2 }
  ]
}

> {%
  client.global.set("csAIId", response.body.data.id);
%}


### [C4] KỲ VỌNG: 200, mỗi set trả categoryId, categoryName, promotionTopN
# Ân đọc đúng bộ theo (round, category)
GET {{baseUrl}}/api/events/{{testEventId}}/criteria-sets
Authorization: Bearer {{coordToken}}


### [C5] KỲ VỌNG: 201, set round-level (category_id IS NULL)
