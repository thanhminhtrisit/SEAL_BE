# CRUD đủ
DELETE {{baseUrl}}/api/events/{{testEventId}}/categories/{{catWebId}}/resources/{{resourceId}}
Authorization: Bearer {{coordToken}}


###
# ============================================================
# NHÓM 6 — Capacity 3 tầng + Mentor planning
# ============================================================

### [CP1] KỲ VỌNG: 200, mentorsNeeded = ceil(3/2) = 2
# Kiểm: tính từ cột override (event E2 đã set maxTeams=3, maxTeamsPerMentor=2)
# Lập kế hoạch mentor hợp lý
# LƯU Ý: activeTeams tính từ team REGISTERED/APPROVED/ACTIVE trong event
#   Khi mới tạo event chưa có team → activeTeams=0 → mentorsNeeded=0
#   Để thấy 2: cần 3 team đã tạo trong testEventId (xem nhóm 7 hoặc tạo tay)
GET {{baseUrl}}/api/events/{{testEventId}}/mentor-planning
Authorization: Bearer {{coordToken}}


### [CP2] KỲ VỌNG: 200, dùng system_configs MAX_TEAMS_PER_MENTOR=5 (tầng 1)
# Resolver rơi về default toàn cục khi event không đặt maxTeamsPerMentor
# LƯU Ý: dùng rejectEventId (event không đặt maxTeamsPerMentor) hoặc event seed id=1
# ⚠ Nếu rejectEventId bị REJECTED, dùng id=1 (seed event) hoặc tạo event mới
GET {{baseUrl}}/api/events/1/mentor-planning
Authorization: Bearer {{coordToken}}


### [CP3] KỲ VỌNG: Bị chặn (business rule capacity — BR-CAP-01)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Team thứ 4 khi maxTeams=3 → không nhận quá sức chứa
# PRE-CONDITION: testEventId phải đang OPEN (E7 đã OPEN) + đã có 3 team active
# ⚠ CẦN SETUP TRƯỚC: tạo 3 team vào testEventId (xem nhóm 7 T1)
#   Sau khi có đủ 3 team, chạy request này để kiểm BR-CAP-01
# ⚠ CẦN ĐIỀN TAY: categoryId — dùng catWebId
POST {{baseUrl}}/api/teams
Authorization: Bearer {{a1Token}}
Content-Type: application/json

{
  "name": "Team Vượt Ngưỡng CP3",
  "description": "Thử đăng ký team thứ 4 khi maxTeams=3",
  "eventId": {{testEventId}},
  "categoryId": {{catWebId}}
}


###
# ============================================================
# NHÓM 7 — Đăng ký & duyệt Team (FR-TEAM-01, BR-TEAM-01)
# PRE-CONDITION: testEventId đang OPEN (sau E7)
# ============================================================

### [T1] KỲ VỌNG: 201, team REGISTERED
# Kiểm DB: teams.status='REGISTERED'
# Đăng ký vào hạng mục Web
POST {{baseUrl}}/api/teams
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "name": "Team Trí T1",
  "description": "Team đăng ký kịch bản kiểm chứng",
  "eventId": {{testEventId}},
  "categoryId": {{catWebId}}
}

> {%
  client.global.set("teamT1Id", response.body.data.id);
%}


### [T2-invite-1] Mời thành viên 1
# Setup cho case T3 — mời đủ người vượt maxTeamSize=4
POST {{baseUrl}}/api/teams/{{teamT1Id}}/invitations
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "email": "tri-test-a1@student.local"
}

> {%
  client.global.set("inviteId1", response.body.data.id);
%}


### [T2-accept-1] A1 chấp nhận lời mời
POST {{baseUrl}}/api/teams/invitations/{{inviteId1}}/accept
Authorization: Bearer {{a1Token}}


### [T2-invite-2] Mời thành viên 2
# ⚠ CẦN ĐIỀN TAY: email thành viên 2 (phải là account ACTIVE đã seed/đăng ký)
#   Ví dụ: member1@student.local (id=8)
POST {{baseUrl}}/api/teams/{{teamT1Id}}/invitations
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "email": "member1@student.local"
}

> {%
  client.global.set("inviteId2", response.body.data.id);
%}


### [T2-accept-2] member1 chấp nhận
# ⚠ CẦN ĐIỀN TAY: token của member1@student.local
#   Lấy bằng [00-member1] login request bên dưới
POST {{baseUrl}}/api/teams/invitations/{{inviteId2}}/accept
Authorization: Bearer {{member1Token}}


### [T2-invite-3] Mời thành viên 3 — để có 4 người total (leader + 3 = 4 = maxTeamSize)
# ⚠ CẦN ĐIỀN TAY: email thành viên 3 (seed member2@student.local hoặc tạo thêm)
POST {{baseUrl}}/api/teams/{{teamT1Id}}/invitations
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "email": "member2@student.local"
}

> {%
  client.global.set("inviteId3", response.body.data.id);
%}


### [T2-accept-3] member2 chấp nhận
# ⚠ CẦN ĐIỀN TAY: token của member2@student.local
POST {{baseUrl}}/api/teams/invitations/{{inviteId3}}/accept
Authorization: Bearer {{member2Token}}


### [T2-invite-4-OVER] Mời thành viên thứ 5 (vượt maxTeamSize=4)
# ĐÂY LÀ CASE ÂM — sẽ bị chặn BR-CAP-03 (nhóm đã đủ sĩ số)
# Dùng cho setup chứng minh — expect 4xx
POST {{baseUrl}}/api/teams/{{teamT1Id}}/invitations
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "email": "tri-test-a8@student.local"
}


### [T3] KỲ VỌNG: Bị chặn (BR-TEAM-01 size check)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Kiểm: team KHÔNG APPROVED — duyệt phải kiểm sĩ số
# LƯU Ý: kịch bản ghi "team > maxTeamSize" nhưng với maxTeamSize=4 và team T1 có 4 người,
#   cần team có 5 người để vượt max. Nếu team hiện có đúng 4 (= max, không > max),
#   case này sẽ pass về BR-CAP-04 (thiếu min) thay vì BR-TEAM-01.
#   Với event đặt maxTeamSize=4: team 4 người hợp lệ → phải có thêm người mới vi phạm.
#   Trong kịch bản Trí: T3 test "team > maxTeamSize" → cần tạo team riêng đã có 5+ người.
#   Nếu DB chưa setup case này, có thể test bằng team có 0-2 người (vi phạm BR-CAP-04 min).
POST {{baseUrl}}/api/teams/{{teamT1Id}}/review
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "approved": true,
  "reason": ""
}


### [T4] KỲ VỌNG: 200 → APPROVED, ghi audit
# Kiểm DB: teams.status='APPROVED', có audit_logs
# Nhánh duyệt + truy vết
# LƯU Ý: team T1 cần có [min, max] active members để approve thành công.
#   Với effectiveMin=3, effectiveMax=4: team phải có 3–4 người active.
#   Nếu T3 đã approve thất bại, T4 dùng cùng team sau khi đã đủ điều kiện.
POST {{baseUrl}}/api/teams/{{teamT1Id}}/review
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "approved": true,
  "reason": ""
}


### [T5] KỲ VỌNG: 200 → REJECTED
# Kiểm DB: teams.status='REJECTED'
# Nhánh từ chối — cần 1 team REGISTERED khác
# SETUP: Tạo team thứ 2 để reject
# ⚠ Cần token của leader khác (hoặc a1Token nếu a1 chưa có team trong event)
# LƯU Ý: a1Token đã join teamT1 → không tạo được team mới trong cùng event
#   → cần tài khoản chưa có team. Dùng tri-test-a8 (đã bị REJECTED account) hoặc
#   tạo thêm account PENDING → approve → tạo team
POST {{baseUrl}}/api/teams/{{teamT1Id}}/review
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "approved": false,
  "reason": "Nhóm không đạt yêu cầu về số lượng thành viên tối thiểu"
}


###
# ============================================================
# NHÓM 8 — Round lifecycle (FIX P0 #1 — FR-EVT-02 / BR-EVT-02 / BR-SCR-05)
# PRE-CONDITION: testEventId đang OPEN (E7), round1Id (order=1) + r1Id (order=3)
#   + r2Id (order=4, final) đã tạo. Máy trạng thái:
#   DRAFT → OPEN_FOR_SUBMISSION → SUBMISSION_CLOSED → SCORING_OPEN → SCORING_LOCKED → COMPLETED
# ============================================================

### [RL1] KỲ VỌNG: Bị chặn (BR-EVT-02 — round order=3 mở khi round order=1 chưa lock)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{r1Id}}/open-submission
Authorization: Bearer {{coordToken}}


### [RL2] KỲ VỌNG: 200 → OPEN_FOR_SUBMISSION (round đầu tiên, order=1)
# Kiểm DB: rounds.status='OPEN_FOR_SUBMISSION'; audit_logs có ROUND_SUBMISSION_OPENED
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/open-submission
Authorization: Bearer {{coordToken}}


### [RL3] KỲ VỌNG: Bị chặn (sai thứ tự — DRAFT không nhảy thẳng SCORING)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/open-scoring
Authorization: Bearer {{coordToken}}


### [RL4] KỲ VỌNG: 200 → SUBMISSION_CLOSED
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/close-submission
Authorization: Bearer {{coordToken}}


### [RL5] KỲ VỌNG: 200 → SCORING_OPEN
# Từ đây judge mới được chấm — chấm SAU khi đóng nộp bài (chống chấm bản cũ)
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/open-scoring
Authorization: Bearer {{coordToken}}


### [RL6] KỲ VỌNG: 200 → SCORING_LOCKED; audit ROUND_LOCKED
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/lock-scoring
Authorization: Bearer {{coordToken}}


### [RL7] KỲ VỌNG: Bị chặn (400 — unlock không có reason)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Trap question: "khóa rồi sửa được không?" → chỉ qua unlock CÓ LÝ DO + audit
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/unlock-scoring
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{}


### [RL8] KỲ VỌNG: 200 → SCORING_OPEN lại; audit ROUND_UNLOCKED kèm reason
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/unlock-scoring
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "reason": "Judge nhập nhầm điểm đội T1 — mở lại để sửa theo biên bản"
}


### [RL9] Khóa lại — KỲ VỌNG: 200 → SCORING_LOCKED
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/lock-scoring
Authorization: Bearer {{coordToken}}


### [RL9-b] Complete round 1 — KỲ VỌNG: 200 → COMPLETED
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{round1Id}}/complete
Authorization: Bearer {{coordToken}}


### [RL10] KỲ VỌNG: 200 — GIỜ round order=3 mở được (round 1 đã COMPLETED)
# Đối chứng với RL1: BR-EVT-02 hoạt động đúng 2 chiều
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{r1Id}}/open-submission
Authorization: Bearer {{coordToken}}


### [RL11] KỲ VỌNG: Bị chặn (403 — super KHÔNG phải owner coordinator)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
POST {{baseUrl}}/api/events/{{testEventId}}/rounds/{{r1Id}}/close-submission
Authorization: Bearer {{superToken}}


###
# ============================================================
# NHÓM 9 — Kiểm chứng FIX P0 #10 (budget) + #2/#3 (submission)
# ============================================================

### [BG1] KỲ VỌNG: 200 nhưng status KHÔNG đổi (vẫn DRAFT) — client không tự duyệt budget được
# Kiểm response: data.status='DRAFT' dù request gửi APPROVED
PATCH {{baseUrl}}/api/events/{{testEventId}}/budget
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "status": "APPROVED"
}


### [SB1] KỲ VỌNG: 201 — team APPROVED (T4) nộp bài được, leader không bị 403
# PRE-CONDITION: teamT1Id đã APPROVED (T4) + round r1Id đang OPEN_FOR_SUBMISSION (RL10)
# Kiểm cả fix #2 (APPROVED được nộp) lẫn #3 (leader thật qua validateTeamLeader trong service)
POST {{baseUrl}}/api/submissions
Authorization: Bearer {{leaderToken}}
Content-Type: application/json

{
  "teamId": {{teamT1Id}},
  "roundId": {{r1Id}},
  "repoUrl": "https://github.com/seal-team-t1/project",
  "changeNote": "Bản nộp kiểm chứng fix P0"
}


### [SB2] KỲ VỌNG: Bị chặn (403 — member thường không phải leader)
# ĐÂY LÀ CASE ÂM: phải nhận status lỗi (4xx), nếu 2xx là BUG
# Chứng minh hạ @PreAuthorize KHÔNG mở lỗ hổng: validateTeamLeader trong service chặn
POST {{baseUrl}}/api/submissions
Authorization: Bearer {{member1Token}}
Content-Type: application/json

{
  "teamId": {{teamT1Id}},
  "roundId": {{r1Id}},
  "repoUrl": "https://github.com/seal-team-t1/fake",
  "changeNote": "Member thường thử nộp — phải bị chặn"
}


###
# ============================================================
# NHÓM 10 — Auto-approve account (system_configs.AUTO_APPROVE_ACCOUNTS)
# Flag mặc định 'false' (giữ hành vi duyệt tay gốc). Bật/tắt bằng SQL
# (Admin config API là scope-cut, xem WBS):
#   UPDATE system_configs SET config_value='true'  WHERE config_key='AUTO_APPROVE_ACCOUNTS';
#   UPDATE system_configs SET config_value='false' WHERE config_key='AUTO_APPROVE_ACCOUNTS';
# DB cũ chưa có row thì chạy:
#   INSERT INTO system_configs (config_key, config_value, description, updated_by)
#   VALUES ('AUTO_APPROVE_ACCOUNTS','false','Auto-activate valid registrations',1);
# ============================================================

### [AA1] Flag=false — KỲ VỌNG: 201, data.status='PENDING' (hành vi gốc, so sánh với A1)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "aa1-flagoff@student.local",
  "password": "Password1",
  "fullName": "Auto Approve Off",
  "fptStudent": true,
  "studentId": "FPT-AA-001"
}


### [AA2] Bật flag bằng SQL ở trên rồi chạy — KỲ VỌNG: 201, data.status='ACTIVE',
# message "auto-approved"; audit_logs có ACCOUNT_AUTO_APPROVED
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "aa2-flagon@student.local",
  "password": "Password1",
  "fullName": "Auto Approve On",
  "fptStudent": true,
  "studentId": "FPT-AA-002"
}


### [AA3] Login NGAY sau AA2 không cần ai duyệt — KỲ VỌNG: 200 + tokens
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "aa2-flagon@student.local",
  "password": "Password1"
}


### [AA4] Đăng ký thiếu studentId khi flag=true — KỲ VỌNG: 400 BR-USR-03
# Chứng minh: auto-approve KHÔNG bỏ qua validation — chỉ bỏ bước duyệt tay
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "aa4-invalid@student.local",
  "password": "Password1",
  "fullName": "Invalid Info",
  "fptStudent": true
}


